/* Phase 9 product-review sample — tokens from docs/PHASE9_DESIGN_SYSTEM.md */

.home-page {
  background: #f7f3ea;
  color: #22231f;
  min-height: 100vh;
  box-sizing: border-box;
}

.home-header {
  margin-bottom: 20rpx;
}

.home-header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.home-title {
  margin: 0;
  flex: 1;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.manage-link {
  margin: 0;
  padding: 0 16rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #756b63;
  background: transparent;
  border: none;
}

.home-subtitle {
  margin-top: 8rpx;
}

.home-secondary-text {
  color: #756b63;
  font-size: 24rpx;
  line-height: 1.55;
}

.home-error {
  margin-bottom: 16rpx;
}

.budget-card,
.settlement-card,
.recent-bills,
.plan-card {
  margin: 16rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fffdfa;
  border: 1rpx solid #e8e1d6;
  box-sizing: border-box;
}

.card-kicker {
  margin-bottom: 8rpx;
  color: #756b63;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.card-title {
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #22231f;
}

.hero-number {
  margin: 8rpx 0 20rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.12;
  color: #22231f;
  overflow-wrap: anywhere;
}

.scale-track {
  position: relative;
  height: 16rpx;
  border-radius: 999rpx;
  background: #efe8dc;
  overflow: hidden;
}

.scale-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #d8f15a;
  max-width: 100%;
}

.scale-fill-prepaid {
  background: #e8b4a8;
}

.scale-fill-normal {
  background: #d8f15a;
}

.scale-mark {
  position: absolute;
  left: 40%;
  top: -4rpx;
  width: 4rpx;
  height: 24rpx;
  background: #22231f;
  opacity: 0.25;
}

.scale-legend {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.status-normal {
  color: #5f7055;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-prepaid {
  color: #a94d3b;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.prepaid-block {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #e8e1d6;
}

.period-line {
  margin-top: 12rpx;
}

.home-primary-cta {
  min-height: 88rpx;
  margin: 8rpx 0 20rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #fffdfa;
  background: #22231f;
  border: none;
}

.settlement-card .home-primary-cta {
  margin-top: 20rpx;
  margin-bottom: 0;
}

.settlement-line {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin: 14rpx 0;
  color: #756b63;
  font-size: 26rpx;
}

.settlement-value {
  color: #22231f;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.settlement-field {
  margin-top: 8rpx;
}

.recent-bills-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #22231f;
}

.all-link {
  margin: 0;
  padding: 0 8rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #5f7055;
  background: transparent;
}

.bills-empty {
  padding: 28rpx 0 12rpx;
  color: #756b63;
  font-size: 26rpx;
  line-height: 1.5;
}

.bill-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #efe8dc;
}

.bill-row:first-of-type {
  border-top: none;
}

.bill-main {
  flex: 1;
  min-width: 0;
}

.bill-category {
  font-size: 28rpx;
  color: #22231f;
  margin-bottom: 4rpx;
  overflow-wrap: anywhere;
}

.bill-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #22231f;
  text-align: right;
  overflow-wrap: anywhere;
}

.plan-section {
  margin-top: 8rpx;
}

.plan-alert {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #f8e4dc;
  color: #a94d3b;
}

.plan-alert-text {
  font-size: 26rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.plan-line {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #efe8dc;
  color: #22231f;
  font-size: 26rpx;
  line-height: 1.45;
}

.plan-line:last-child {
  border-bottom: none;
}

.plan-line-value {
  color: #a94d3b;
  text-align: right;
  overflow-wrap: anywhere;
}

.notice {
  margin-bottom: 8rpx;
  color: #756b63;
  font-size: 24rpx;
  line-height: 1.5;
}

.pending-plan {
  margin-top: 12rpx;
}

.pending-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 12rpx 0;
  padding: 0 20rpx;
  border: 1rpx solid #e8e1d6;
  border-radius: 16rpx;
  background: #fffdfa;
  text-align: left;
  font-size: 28rpx;
}

.secondary-button {
  min-height: 88rpx;
  margin: 12rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #22231f;
  background: #efe8dc;
  border: none;
}

.field {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  border-bottom: 1rpx solid #efe8dc;
}

.field-label {
  width: 190rpx;
  color: #756b63;
  font-size: 26rpx;
}

.field-input,
.picker-value {
  flex: 1;
  color: #22231f;
  text-align: right;
  font-size: 26rpx;
}

@media (max-width: 320px) {
  .home-title {
    font-size: 36rpx;
  }

  .hero-number {
    font-size: 56rpx;
  }

  /* Keep title+管理 and bill main+amount on one row at 320px */
  .home-header-row,
  .recent-bills-head,
  .bill-row {
    flex-direction: row;
    align-items: center;
  }

  .bill-row {
    align-items: flex-start;
  }

  .settlement-line,
  .plan-line,
  .scale-legend {
    flex-direction: column;
    align-items: stretch;
  }

  .settlement-value,
  .plan-line-value,
  .picker-value,
  .field-input {
    text-align: left;
  }

  .bill-amount {
    text-align: right;
  }

  .field {
    flex-direction: column;
    align-items: stretch;
    gap: 8rpx;
    padding: 12rpx 0;
  }

  .field-label {
    width: auto;
  }

  .home-primary-cta,
  .secondary-button {
    width: 100%;
  }
}
