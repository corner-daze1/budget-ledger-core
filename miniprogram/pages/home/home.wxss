.hero-card {
  margin: 34rpx 0 22rpx;
  padding: 42rpx 34rpx;
  border-radius: 28rpx;
  background: #2f302b;
  color: #fffdfa;
}

.hero-card .card-title { color: #c7bdb1; }
.hero-number { margin: 12rpx 0; font-size: 76rpx; font-weight: 600; letter-spacing: 1rpx; }
.hero-caption { color: #c7bdb1; font-size: 23rpx; }
.settlement-card { margin: 34rpx 0 22rpx; padding: 30rpx; border: 1rpx solid #d9c5b7; border-radius: 28rpx; background: #fffaf5; }
.settlement-line { display: flex; justify-content: space-between; margin: 14rpx 0; color: #756b63; }
.settlement-line text:last-child { color: #2f302b; font-weight: 600; }
.status-card { padding: 24rpx 30rpx; border-radius: 22rpx; background: #efe5db; }
.status-line { display: flex; justify-content: space-between; margin: 8rpx 0; color: #756b63; }
.status-value { color: #9b4d3a; font-weight: 600; }
.nav-row { display: flex; gap: 18rpx; }
.nav-button { flex: 1; }
.asset-button { margin: 18rpx 0 4rpx; border: 1rpx solid #b85c45; border-radius: 16rpx; color: #9b4d3a; background: transparent; }
.plan-card { margin: 22rpx 0; padding: 28rpx; border-radius: 22rpx; background: #fffdfa; border: 1rpx solid #eadfd6; }
.plan-alert { margin: 22rpx 0; padding: 22rpx 26rpx; border-radius: 18rpx; background: #f8e4dc; color: #8f3f2f; }
.plan-line { display: flex; justify-content: space-between; gap: 20rpx; padding: 14rpx 0; border-bottom: 1rpx solid #eee5de; color: #5f5751; font-size: 25rpx; }
.plan-line text:last-child { color: #9b4d3a; }
.pending-plan { margin-top: 18rpx; padding-top: 8rpx; }
.pending-plan .field-input { margin: 12rpx 0; }
.hero-number, .status-value, .plan-line text, .settlement-line text { overflow-wrap: anywhere; }

@media (max-width: 320px) {
  .hero-number { font-size: 60rpx; }
  .status-line, .settlement-line, .plan-line, .nav-row { align-items: stretch; flex-direction: column; }
  .nav-row { gap: 0; }
}
