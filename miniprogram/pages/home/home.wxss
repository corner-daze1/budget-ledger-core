.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  color: #202521;
  background: #F6F5F0;
}

.home-header {
  margin-bottom: 24rpx;
}

.home-title {
  margin: 0;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.home-subtitle {
  margin-top: 8rpx;
}

.home-secondary-text {
  color: #5F665F;
  font-size: 24rpx;
  line-height: 1.55;
}

.home-error {
  margin-bottom: 16rpx;
}

.budget-card,
.settlement-card,
.recent-bills,
.plan-card {
  box-sizing: border-box;
  margin: 16rpx 0;
  padding: 28rpx;
  border: 1rpx solid #E5E7E2;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(32, 37, 33, 0.05);
}

.card-kicker {
  margin-bottom: 8rpx;
  color: #5F665F;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.card-title {
  margin-bottom: 12rpx;
  color: #202521;
  font-size: 32rpx;
  font-weight: 600;
}

.hero-number {
  margin: 8rpx 0 20rpx;
  color: #202521;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.12;
  overflow-wrap: anywhere;
}

.scale-track {
  position: relative;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E8F0EB;
}

.scale-fill {
  height: 100%;
  max-width: 100%;
  border-radius: 999rpx;
}

.scale-fill-normal {
  background: #3E725E;
}

.scale-fill-prepaid {
  background: #B85A4A;
}

.scale-fill-settlement {
  background: #E5E7E2;
}

.scale-mark {
  position: absolute;
  top: -4rpx;
  left: 40%;
  width: 4rpx;
  height: 24rpx;
  background: #202521;
  opacity: 0.3;
}

.scale-legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.status-normal,
.status-prepaid {
  font-size: 24rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.status-normal {
  color: #3E725E;
}

.status-prepaid {
  margin-top: 8rpx;
  color: #B85A4A;
}

.prepaid-block {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #E5E7E2;
}

.period-line {
  margin-top: 12rpx;
}

.settlement-line {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  margin: 14rpx 0;
  color: #5F665F;
  font-size: 26rpx;
}

.settlement-value {
  color: #202521;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.settlement-field {
  margin-top: 8rpx;
}

.home-primary-cta {
  min-height: 88rpx;
  margin: 20rpx 0 0;
  color: #FFFFFF;
  font-size: 28rpx;
  border: 0;
  border-radius: 16rpx;
  background: #3E725E;
}

.recent-bills-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.section-title {
  color: #202521;
  font-size: 28rpx;
  font-weight: 600;
}

.all-link {
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  color: #3E725E;
  font-size: 26rpx;
  line-height: 88rpx;
  background: transparent;
}

.bills-empty {
  padding: 28rpx 0 12rpx;
  color: #5F665F;
  font-size: 26rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.bill-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #E5E7E2;
}

.bill-row:first-of-type {
  border-top: 0;
}

.bill-main {
  flex: 1;
  min-width: 0;
}

.bill-category {
  margin-bottom: 4rpx;
  color: #202521;
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.bill-amount {
  flex-shrink: 0;
  color: #202521;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.plan-section {
  margin-top: 8rpx;
}

.plan-alert {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 0;
  padding: 22rpx 26rpx;
  color: #B85A4A;
  border: 1rpx solid #F0D1C9;
  border-radius: 18rpx;
  background: #F9E9E5;
}

.plan-alert-text,
.plan-line,
.notice {
  overflow-wrap: anywhere;
}

.plan-alert-text {
  font-size: 26rpx;
  line-height: 1.55;
}

.plan-line {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  color: #202521;
  font-size: 26rpx;
  line-height: 1.45;
  border-bottom: 1rpx solid #E5E7E2;
}

.plan-line:last-child {
  border-bottom: 0;
}

.plan-line-value {
  color: #B85A4A;
  text-align: right;
  overflow-wrap: anywhere;
}

.notice {
  margin-bottom: 8rpx;
  color: #5F665F;
  font-size: 24rpx;
  line-height: 1.5;
}

.pending-plan {
  margin-top: 12rpx;
}

.pending-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 12rpx 0;
  padding: 0 20rpx;
  color: #202521;
  font-size: 28rpx;
  text-align: left;
  border: 1rpx solid #E5E7E2;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.secondary-button {
  min-height: 88rpx;
  margin: 12rpx 0;
  color: #3E725E;
  font-size: 28rpx;
  border: 0;
  border-radius: 16rpx;
  background: #E8F0EB;
}

.field {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  border-bottom: 1rpx solid #E5E7E2;
}

.field-label {
  width: 190rpx;
  color: #5F665F;
  font-size: 26rpx;
}

.field-input,
.picker-value {
  flex: 1;
  color: #202521;
  font-size: 26rpx;
  text-align: right;
}

@media (max-width: 320px) {
  .home-title {
    font-size: 38rpx;
  }

  .hero-number {
    font-size: 56rpx;
  }

  .settlement-line,
  .plan-line,
  .scale-legend {
    flex-direction: column;
    align-items: stretch;
  }

  .settlement-value,
  .plan-line-value,
  .picker-value,
  .field-input {
    text-align: left;
  }

  .bill-row {
    flex-direction: row;
  }

  .bill-amount {
    text-align: right;
  }

  .field {
    flex-direction: column;
    align-items: stretch;
    gap: 8rpx;
    padding: 12rpx 0;
  }

  .field-label {
    width: auto;
  }
}
