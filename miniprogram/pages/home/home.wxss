.hero-card {
  margin: 34rpx 0 22rpx;
  padding: 42rpx 34rpx;
  border-radius: 28rpx;
  background: #2f302b;
  color: #fffdfa;
}

.hero-card .card-title { color: #c7bdb1; }
.hero-number { margin: 12rpx 0; font-size: 76rpx; font-weight: 600; letter-spacing: 1rpx; }
.hero-caption { color: #c7bdb1; font-size: 23rpx; }
.status-card { padding: 24rpx 30rpx; border-radius: 22rpx; background: #efe5db; }
.status-line { display: flex; justify-content: space-between; margin: 8rpx 0; color: #756b63; }
.status-value { color: #9b4d3a; font-weight: 600; }
.nav-row { display: flex; gap: 18rpx; }
.nav-button { flex: 1; }
