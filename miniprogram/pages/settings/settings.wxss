.field-input { min-width: 0; }
.notice { margin: 18rpx 0; padding: 20rpx; border-radius: 16rpx; color: #46624b; background: #e1eee2; }
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 26rpx 0; }
.summary-card { display: flex; flex-direction: column; padding: 24rpx; border-radius: 20rpx; background: #fffdfa; }
.summary-card text { color: #8b7d72; font-size: 23rpx; }
.summary-card strong { margin-top: 10rpx; font-size: 32rpx; }
.summary-card.liability strong { color: #9b4d3a; }
.summary-card.net { color: #fffdfa; background: #2f302b; }
.summary-card.net text { color: #c7bdb1; }
.section-title { margin: 34rpx 0 14rpx; font-size: 34rpx; font-weight: 600; }
.account-card { display: flex; justify-content: space-between; align-items: center; margin: 12rpx 0; padding: 24rpx 26rpx; border-radius: 20rpx; background: #fffdfa; }
.account-name { font-size: 30rpx; font-weight: 600; }
.account-type { margin-top: 8rpx; color: #9c8f83; font-size: 22rpx; }
.account-balance { font-size: 32rpx; font-weight: 600; }
.account-balance.debt { color: #9b4d3a; }
.lifecycle-card { border: 2rpx solid #ded5ca; }
.setting-line { display: flex; justify-content: space-between; gap: 20rpx; margin: 14rpx 0; color: #776b61; font-size: 24rpx; }
.setting-line text:last-child { color: #2f302b; text-align: right; font-weight: 600; }
.scope-hint { margin: 12rpx 0 24rpx; color: #8b7d72; font-size: 22rpx; line-height: 1.6; }
.warning { margin: 18rpx 0; padding: 18rpx; border-radius: 14rpx; color: #8a4d35; background: #f7e6dc; font-size: 23rpx; }
.preview-card { margin: 18rpx 0; padding: 22rpx; border-radius: 16rpx; background: #f2eee8; line-height: 1.6; }
.compact-button { margin-top: 18rpx; }
.fixed-hint { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #e6ded5; color: #7d6e62; font-size: 23rpx; line-height: 1.7; }
.plan-editor { border: 2rpx solid #d8c8bc; }
.reminder-options { display: flex; justify-content: space-between; margin: 16rpx 0 24rpx; color: #6f6258; font-size: 24rpx; }
.plan-list-item { padding: 18rpx 0; border-bottom: 1rpx solid #e8dfd7; }
.plan-actions { display: flex; justify-content: flex-end; gap: 12rpx; }
.plan-actions button { margin: 0; }
.danger { color: #9b4d3a; }
