<view class="page">
  <view class="eyebrow">YONGDU / FLOWS</view>
  <view class="title">最近流水</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!flows.length}}" class="card empty">还没有流水，记下第一笔吧。</view>
  <view wx:for="{{flows}}" wx:key="id" class="bill-card">
    <view class="bill-top"><text class="bill-category">{{item.typeLabel}} · {{item.category}}</text><text class="bill-amount">{{item.amount}}</text></view>
    <view class="bill-bottom"><text class="bill-meta">{{item.accountFlow}}</text><text class="bill-meta">{{item.date}}</text></view>
    <view class="bill-bottom"><text class="bill-budget">{{item.budgetType}}</text></view>
    <view wx:if="{{item.note}}" class="bill-note">{{item.note}}</view>
  </view>
</view>
