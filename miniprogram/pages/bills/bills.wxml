<view class="page">
  <view class="eyebrow">YONGDU / RECENT</view>
  <view class="title">最近账单</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!bills.length}}" class="card empty">还没有账单，记下第一笔吧。</view>
  <view wx:for="{{bills}}" wx:key="id" class="bill-card">
    <view class="bill-top"><text class="bill-category">{{item.category}}</text><text class="bill-amount">{{item.amount}}</text></view>
    <view class="bill-bottom"><text class="bill-meta">{{item.budgetType}} · {{item.account}}</text><text class="bill-meta">{{item.date}}</text></view>
    <view wx:if="{{item.note}}" class="bill-note">{{item.note}}</view>
  </view>
</view>
