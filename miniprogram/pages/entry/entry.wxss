.form-card { padding-top: 22rpx; }
.amount-label { color: #756b63; font-size: 24rpx; }
.amount-input { margin: 8rpx 0 22rpx; font-size: 70rpx; font-weight: 600; }
.switch-row { display: flex; justify-content: space-between; align-items: center; min-height: 90rpx; color: #756b63; }
.previous-card { margin: 24rpx 0; padding: 24rpx 30rpx; border-left: 6rpx solid #b85c45; border-radius: 4rpx 18rpx 18rpx 4rpx; background: #fffdfa; }
.previous-text { color: #b85c45; font-size: 30rpx; }
.mode-tabs { display: flex; margin: 0 0 24rpx; padding: 8rpx; border-radius: 18rpx; background: #eadfd6; }
.mode-tab { flex: 1; padding: 18rpx 0; border-radius: 14rpx; color: #756b63; text-align: center; }
.mode-tab.active { color: #fffdfa; background: #b85c45; }
.empty-state { color: #8b7d72; line-height: 1.6; text-align: center; }
.amount-input, .previous-text { overflow-wrap: anywhere; }

@media (max-width: 320px) {
  .amount-input { font-size: 56rpx; }
  .mode-tab { min-width: 0; padding-right: 4rpx; padding-left: 4rpx; }
}
